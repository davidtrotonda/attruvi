{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "attruvi-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_CONFIG_CACHE_TTL_SECONDS": "60",
    "MAX_REQUEST_BYTES": "262144"
  },
  "kv_namespaces": [
    { "binding": "APP_CONFIG_CACHE" }
  ],
  "queues": {
    "producers": [
      { "binding": "EVENT_QUEUE", "queue": "attruvi-ingest-events" },
      { "binding": "DEAD_LETTER_QUEUE", "queue": "attruvi-ingest-dead-letter" }
    ],
    "consumers": [
      {
        "queue": "attruvi-ingest-events",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 15
      }
    ]
  },
  "ratelimits": [
    {
      "name": "APP_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 1200, "period": 60 }
    },
    {
      "name": "IP_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "ABUSE_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "INGEST_METRICS", "dataset": "attruvi_ingest_metrics" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
