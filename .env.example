# Modo y URLs públicas (no contienen secretos)
ATTRUVI_REQUIRE_PLATFORM_ENV=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SMART_LINK_BASE_URL=
ATTRUVI_LINKS_BASE_URL=
ATTRUVI_INGEST_BASE_URL=

# Supabase: solo servidor. Prioriza la nueva secret key; la service role queda para migraciones heredadas.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth de Google administrado en Supabase; nunca uses prefijo NEXT_PUBLIC para el secreto.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Worker de enlaces y firma anti-replay de su endpoint administrativo.
ATTRUVI_LINKS_WORKER_URL=
ATTRUVI_LINKS_SYNC_TOKEN=

# Llavero OAuth: JSON {"version":"base64-de-32-bytes"} y versión activa.
CONNECTOR_ENCRYPTION_KEYS=
CONNECTOR_ENCRYPTION_ACTIVE_KEY_VERSION=
# Solo para migración desde instalaciones antiguas; no lo uses en despliegues nuevos.
CONNECTOR_ENCRYPTION_KEY=

# Protege los cron de costes, métricas, postbacks y retención.
CRON_SECRET=

# Google Ads
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Meta Ads
META_ADS_APP_ID=
META_ADS_APP_SECRET=

# TikTok Ads
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=

# Smoke tests operativos opcionales. No son necesarios para desarrollar.
ATTRUVI_SMOKE_BASE_URL=
ATTRUVI_SMOKE_EMAIL=
ATTRUVI_SMOKE_PASSWORD=
ATTRUVI_SMOKE_REVOKE_ONLY=
ATTRUVI_SMOKE_SUPABASE_URL=
ATTRUVI_SMOKE_SUPABASE_PUBLISHABLE_KEY=
ATTRUVI_SMOKE_VERCEL_CLI=
ATTRUVI_SMOKE_VERCEL_CLI_PATH=
